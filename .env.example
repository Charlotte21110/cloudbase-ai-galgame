# ============================================
# CloudBase 环境配置（复制本文件为 .env.local 后填入真实值）
# 切勿提交 .env.local 到 git！
# ============================================

# 【必填】CloudBase 环境 ID
# 获取方式：https://tcb.cloud.tencent.com/ → 进入你的环境 → 概览页顶部
VITE_ENV_ID=

# 【必填】客户端 Publishable Key（公开密钥，端上可见，安全）
# 获取方式：https://tcb.cloud.tencent.com/dev?envId=你的环境ID#/env/apikey
# 点击"新建" → 选"Publishable" → 复制
VITE_PUBLISHABLE_KEY=

# ============================================
# ⚠️ 下面三个仅用于 iOS/Android 原生 App 端，H5 和小程序请保持为空！
#
# 这是 CloudBase「应用安全配置」给原生 App 用的"应用凭证"，
# 不是腾讯云的 SecretId/SecretKey（AKID... 开头那种千万别填这里，那是
# 主账号万能密钥，泄露到前端等于把账号送人）。
#
# 获取入口：CloudBase 控制台 → 环境 → 应用配置 → 应用管理 → 创建一个 App 应用，
# 得到 appSign + appAccessKeyId + appAccessKey 三件套。
# ============================================
VITE_APP_SIGN=
VITE_APP_ACCESS_KEY_ID=
VITE_APP_ACCESS_KEY=
